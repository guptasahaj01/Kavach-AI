# KAVACH v2 Environment Configuration Template

# Server Configuration
KAVACH_HOST=127.0.0.1
KAVACH_PORT=8000

# Layer 2 Pretrained ML Classifier
# Default: deepset/deberta-v3-base-injection (ungated, runs locally on CPU/MPS)
# Alternative (requires HF_TOKEN): meta-llama/Llama-Prompt-Guard-2-22M, meta-llama/Prompt-Guard-86M
KAVACH_ML_MODEL=deepset/deberta-v3-base-injection
KAVACH_ML_THRESHOLD=0.50
KAVACH_MAX_TOKEN_LEN=512

# Optional Hugging Face Token for gated models
# HF_TOKEN=hf_...

# SQLite Audit Database
KAVACH_DB_PATH=kavach.db

# LLM Simulation Mode (calibrated, ollama, or api)
LLM_BACKEND_TYPE=calibrated
