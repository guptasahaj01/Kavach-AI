# Export these variables before starting Python; the server does not implicitly
# read .env. For a shell: set -a, source .env, then set +a (on separate lines).
KAVACH_HOST=127.0.0.1
KAVACH_PORT=8000

# Local injection classifier. First initialization may download its weights.
KAVACH_ML_MODEL=deepset/deberta-v3-base-injection
KAVACH_ML_THRESHOLD=0.50
KAVACH_MAX_TOKEN_LEN=512
# HF_TOKEN=replace_with_a_token_if_a_gated_model_is_selected

KAVACH_DB_PATH=kavach.db

# The protected workflow requires a real generator. It never falls back to the
# calibrated simulator, which is available only through research tools.
KAVACH_LLM_BACKEND=ollama
# Operational local default; evaluate model capability and security separately.
KAVACH_LLM_MODEL=qwen2.5:3b
KAVACH_OLLAMA_URL=http://127.0.0.1:11434
KAVACH_LLM_TIMEOUT=45

# Bounded advisory review of complete, ML-only flags with zero rule findings.
# Uses the real generation backend without tools; at most 4 reviews per request.
# Set 0 to retain the strict classifier gate. Review never grants permissions.
KAVACH_CONTEXT_REVIEW=1

# Optional opaque bearer credentials. Unset means anonymous public access only.
# Replace the example credential before enabling; do not commit real keys.
# KAVACH_API_KEYS='{"replace-with-a-long-random-token":{"principal_id":"customer-1","role":"authenticated_customer","account_ids":["CUST_1001"],"allowed_destinations":[]}}'
