# Local development uses the Vite proxy by default.
# Public HTTPS backend URL without trailing slash; never put a token here.
VITE_API_BASE_URL=
# Set true for a static public host; shows a clear notice if no backend is set.
VITE_STATIC_HOST=false
# /Kavach-AI/ for the default GitHub project URL; / for a custom domain.
VITE_BASE_PATH=/
